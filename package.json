{
  "name": "todo-api-devops",
  "version": "1.0.0",
  "description": "API REST de tarefas (to-do list) usada na disciplina DevOps na Prática - PUCRS Online",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "jest --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/app.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "branches": 70,
        "functions": 80,
        "statements": 80
      }
    }
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
